{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "screen.schema.json",
  "title": "Screen layout tree (apps/<app>/screens/<screen>.json)",
  "description": "All coordinates are unit coordinates measured on the canonical capture (absolute within the captured screen, not relative to the parent). The renderer multiplies by 240 / unit_width and rounds edges to whole pixels.",
  "type": "object",
  "required": ["schema", "id"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string"},
    "source": {"type": "string", "description": "Reference capture(s) this screen was transcribed from"},
    "unit_width": {"type": "number", "exclusiveMinimum": 0},
    "height": {"type": "number", "exclusiveMinimum": 0, "description": "Full captured (stitched) height in units"},
    "bg": {"$ref": "#/$defs/color"},
    "bg_image": {"$ref": "#/$defs/asset"},
    "status_bar": {"type": "boolean", "description": "Overlay the system status bar fragment at the top"},
    "top_h": {"type": "number", "minimum": 0, "description": "Pinned top region height (status bar + headers)"},
    "bottom_h": {"type": "number", "minimum": 0, "description": "Pinned bottom region height (dock / tab bar)"},
    "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}}
  },
  "$defs": {
    "color": {"type": "string", "pattern": "^(#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|\\$[A-Za-z0-9_.-]+)$"},
    "asset": {"type": "string", "pattern": "^([A-Za-z0-9_-]+:)?(assets|video|audio)/[^\\s]+$"},
    "screenRef": {"type": "string", "pattern": "^[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+$"},
    "box": {
      "type": "object",
      "properties": {
        "x": {"type": "number"}, "y": {"type": "number"},
        "w": {"type": "number", "minimum": 0}, "h": {"type": "number", "minimum": 0},
        "bg": {"$ref": "#/$defs/color"},
        "bg_grad": {
          "type": "object",
          "required": ["colors"],
          "additionalProperties": false,
          "properties": {
            "dir": {"enum": ["ver", "hor"]},
            "colors": {"type": "array", "items": {"$ref": "#/$defs/color"}, "minItems": 2, "maxItems": 2},
            "stops": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 255}, "minItems": 2, "maxItems": 2}
          }
        },
        "radius": {"type": "number", "minimum": 0, "description": ">= 9999 means a full circle/pill"},
        "border_w": {"type": "number", "minimum": 0},
        "border_color": {"$ref": "#/$defs/color"},
        "opa": {"type": "integer", "minimum": 0, "maximum": 255},
        "clip": {"type": "boolean"}
      }
    },
    "pressed": {
      "description": "Pressed state. Only when captured (PLAN.md §7.1).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bg": {"$ref": "#/$defs/color"},
        "bg_grad": {"$ref": "#/$defs/box/properties/bg_grad"},
        "border_w": {"type": "number"}, "border_color": {"$ref": "#/$defs/color"},
        "radius": {"type": "number"}, "opa": {"type": "integer", "minimum": 0, "maximum": 255}
      }
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {"properties": {"type": {"const": "open_screen"}, "target": {"$ref": "#/$defs/screenRef"},
                        "transition": {"$ref": "manifest.schema.json#/$defs/transition"}},
         "required": ["target"], "additionalProperties": false},
        {"properties": {"type": {"const": "back"}}, "additionalProperties": false},
        {"properties": {"type": {"const": "home"}}, "additionalProperties": false},
        {"properties": {"type": {"const": "play_video"}, "target": {"type": "string"}}, "additionalProperties": false},
        {"properties": {"type": {"const": "run_sequence"},
                        "steps": {"type": "array", "minItems": 1, "items": {
                          "type": "object", "required": ["screen", "ms"], "additionalProperties": false,
                          "properties": {"screen": {"$ref": "#/$defs/screenRef"}, "ms": {"type": "integer", "minimum": 0}}}},
                        "end": {"enum": ["back", "stay"]}},
         "required": ["steps"], "additionalProperties": false}
      ]
    },
    "common": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "region": {"enum": ["top", "body", "bottom"]},
        "hidden": {"type": "boolean"},
        "action": {"$ref": "#/$defs/action"},
        "pressed": {"$ref": "#/$defs/pressed"},
        "source": {"type": "string"}
      }
    },
    "element": {
      "type": "object",
      "required": ["type"],
      "allOf": [{"$ref": "#/$defs/box"}, {"$ref": "#/$defs/common"}],
      "oneOf": [
        {"properties": {"type": {"const": "text"},
                        "text": {"type": "string"},
                        "font": {"type": "string"},
                        "color": {"$ref": "#/$defs/color"},
                        "align": {"enum": ["left", "center", "right"]},
                        "valign": {"enum": ["top", "center", "bottom"]},
                        "mode": {"enum": ["wrap", "clip", "dots"]},
                        "line_space": {"type": "number"},
                        "letter_space": {"type": "number"},
                        "clock_format": {"type": "string"}},
         "required": ["text", "font"]},
        {"properties": {"type": {"const": "image"}, "src": {"$ref": "#/$defs/asset"},
                        "pressed_src": {"$ref": "#/$defs/asset"}},
         "required": ["src"]},
        {"properties": {"type": {"enum": ["rect", "button"]},
                        "children": {"type": "array", "items": {"$ref": "#/$defs/element"}}}},
        {"properties": {"type": {"const": "scroll"}, "dir": {"enum": ["x", "y"]}, "snap": {"enum": ["none", "page"]},
                        "loop": {"type": "boolean"}, "start": {"type": "number"},
                        "children": {"type": "array", "items": {"$ref": "#/$defs/element"}}},
         "required": ["w", "h"]},
        {"properties": {"type": {"const": "list"},
                        "items": {"type": "array", "items": {
                          "type": "object",
                          "allOf": [{"$ref": "#/$defs/box"}, {"$ref": "#/$defs/common"}],
                          "properties": {"children": {"type": "array", "items": {"$ref": "#/$defs/element"}}}}}},
         "required": ["items"]},
        {"properties": {"type": {"const": "video"}, "src": {"$ref": "#/$defs/asset"},
                        "poster": {"$ref": "#/$defs/asset"},
                        "autoplay": {"type": "boolean"}, "loop": {"type": "boolean"}},
         "required": ["src", "w", "h"]},
        {"description": "Reserved for the radio (PLAN.md §9); calls the audio stub.",
         "properties": {"type": {"const": "station"}, "src": {"type": "string"},
                        "children": {"type": "array", "items": {"$ref": "#/$defs/element"}}}}
      ]
    }
  }
}
